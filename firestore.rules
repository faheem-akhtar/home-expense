rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if isMember(hid) ||
        // Joining: the only change is adding yourself, and only one partner can join.
        (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.members.size() < 2
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members);

      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
